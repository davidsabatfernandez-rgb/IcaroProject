# Only on the server. Add in Vercel > Settings > Environment Variables > Production.
# Register Resend using contacticaroproject@gmail.com to use its test sender.
RESEND_API_KEY=
# Optional: after verifying a sending domain in Resend, set its sender address.
# Without this value, onboarding@resend.dev only sends to the Resend account owner.
RESEND_FROM_EMAIL=
