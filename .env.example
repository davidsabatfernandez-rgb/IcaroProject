# Solo en el servidor: Vercel > Settings > Environment Variables > Production.
# La cuenta Resend debe usar contacticaroproject@gmail.com para su remitente de prueba.
RESEND_API_KEY=
# Opcional, después de verificar un dominio remitente en Resend.
# Sin este valor, onboarding@resend.dev solo envía al propietario de la cuenta Resend.
RESEND_FROM_EMAIL=

# Identificadores públicos reales de ICARO. Vacíos: medición desactivada.
# Se incorporan al compilar. Tras configurarlos, desplegar de nuevo.
# No añadas otro tag o gestor de etiquetas en paralelo.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
